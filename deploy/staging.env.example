# Copy to root .env.staging. All values below are placeholders; keep the real file private.
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
POSTGRES_DB=shuttlebook
POSTGRES_USER=shuttlebook
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
ConnectionStrings__ShuttleBook=Host=postgres;Port=5432;Database=shuttlebook;Username=shuttlebook;Password=REPLACE_WITH_SAME_PASSWORD
Identity__JwtSigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Identity__OtpPepper=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
DataProtection__CertificatePassword=REPLACE_WITH_PFX_EXPORT_PASSWORD
AllowedHosts=localhost;127.0.0.1
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175
BrowserSession__CustomerOrigin=http://localhost:5173
BrowserSession__PartnerOrigin=http://localhost:5174
AdminSession__AllowedOrigin=http://localhost:5175
Media__Mode=S3
Media__S3Region=ap-southeast-1
Media__S3Bucket=REPLACE_WITH_PRIVATE_MEDIA_BUCKET
Identity__Delivery__SmtpHost=email-smtp.ap-southeast-1.amazonaws.com
Identity__Delivery__SmtpPort=587
Identity__Delivery__From=REPLACE_WITH_VERIFIED_SENDER
Identity__Delivery__SmtpUsername=REPLACE_WITH_SES_SMTP_USERNAME
Identity__Delivery__SmtpPassword=REPLACE_WITH_SES_SMTP_PASSWORD
Identity__Delivery__SmtpUseStartTls=true
Identity__Delivery__RequireTlsAndAuth=true
Identity__Delivery__AllowSyntheticPhone=false
VITE_MAPTILER_API_KEY=REPLACE_WITH_PUBLIC_BROWSER_MAP_KEY
