FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json ./
COPY backend/ ./backend/
ARG APP_NAME
RUN test -n "$APP_NAME" && dotnet restore "backend/src/$APP_NAME/$APP_NAME.csproj" --locked-mode
RUN dotnet publish "backend/src/$APP_NAME/$APP_NAME.csproj" -c Release --no-restore -o /out --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/ ./
ARG APP_NAME
ENV APP_NAME=$APP_NAME
RUN mkdir -p /app/dp-keys && chown -R 1654:1654 /app
USER 1654
ENTRYPOINT ["sh", "-c", "exec dotnet \"/app/${APP_NAME}.dll\" \"$@\"", "--"]
