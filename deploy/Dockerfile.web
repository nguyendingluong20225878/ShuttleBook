FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
RUN npm ci
ARG VITE_MAPTILER_API_KEY=""
ENV VITE_MAPTILER_API_KEY=$VITE_MAPTILER_API_KEY
ARG CUSTOMER_API_BASE_URL=http://localhost:5173
ARG PARTNER_API_BASE_URL=http://localhost:5174
ARG ADMIN_API_BASE_URL=http://localhost:5175
RUN VITE_API_BASE_URL="$CUSTOMER_API_BASE_URL" npm run build --workspace @shuttlebook/customer-web
RUN VITE_API_BASE_URL="$PARTNER_API_BASE_URL" npm run build --workspace @shuttlebook/partner-web
RUN VITE_API_BASE_URL="$ADMIN_API_BASE_URL" npm run build --workspace @shuttlebook/admin-web

FROM caddy:2-alpine
COPY deploy/Caddyfile.staging /etc/caddy/Caddyfile
COPY --from=build /src/apps/customer-web/dist /srv/customer
COPY --from=build /src/apps/partner-web/dist /srv/partner
COPY --from=build /src/apps/admin-web/dist /srv/admin
