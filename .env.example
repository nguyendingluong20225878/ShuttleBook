# Local development only. Run scripts/Initialize-Local.ps1 to generate .env safely.
POSTGRES_DB=shuttlebook
POSTGRES_USER=shuttlebook
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=54329
IDENTITY_OTP_PEPPER=replace-with-random-local-secret
IDENTITY_JWT_SIGNING_KEY=replace-with-random-local-secret
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
VITE_API_BASE_URL=http://localhost:5080
VITE_MAPTILER_API_KEY=
AdminSession__AllowedOrigin=http://localhost:5175
BrowserSession__CustomerOrigin=http://localhost:5173
BrowserSession__PartnerOrigin=http://localhost:5174
Media__Mode=Local
Booking__QuoteSeconds=120
Booking__MaxAdvanceDays=60
Outbox__AlertAttempts=8
# For a local SES OTP test, use Staging above and fill these only in ignored .env.
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=http://localhost:5174
# Cors__AllowedOrigins__2=http://localhost:5175
# Identity__Delivery__SmtpHost=email-smtp.ap-southeast-1.amazonaws.com
# Identity__Delivery__SmtpPort=587
# Identity__Delivery__From=replace-with-verified-sender@example.com
# Identity__Delivery__SmtpUsername=replace-with-ses-smtp-username
# Identity__Delivery__SmtpPassword=replace-with-ses-smtp-password
# Identity__Delivery__SmtpUseStartTls=true
# Identity__Delivery__RequireTlsAndAuth=true
# Identity__Delivery__AllowSyntheticPhone=false
# For a separate private test bucket, set Media__Mode=S3 and fill these two values.
# Media__S3Region=replace-with-test-bucket-region
# Media__S3Bucket=replace-with-private-test-bucket-name
